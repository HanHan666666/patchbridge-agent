<?xml version="1.0" encoding="UTF-8"?>
<!--
  演示应用：模拟一个典型的存量企业系统（Java 8 + Spring Boot 2.7 + Spring Security
  RBAC + H2），引入 Starter 后获得浏览器 Agent 能力与同 JVM 单次模型调用门面。
  Global MCP Server 由 /ai-admin 写入 JDBC，Demo 不内置 Mock 协议服务。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.patchbridge.agent</groupId>
        <artifactId>patchbridge-agent-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>patchbridge-agent-demo</artifactId>
    <name>PatchBridge Agent Demo</name>

    <dependencies>
        <dependency>
            <groupId>io.patchbridge.agent</groupId>
            <artifactId>patchbridge-agent-spring-boot2-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
